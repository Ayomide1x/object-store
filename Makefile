BUF := go run github.com/bufbuild/buf/cmd/buf@v1.75.0

.PHONY: proto proto-lint proto-breaking build vet web web-check

# Regenerate Go stubs into gen/go (committed). Java stubs are generated by Gradle.
proto:
	$(BUF) generate

proto-lint:
	$(BUF) lint

# Fails if the wire format changed incompatibly versus main (invariant 9).
proto-breaking:
	$(BUF) breaking --against '.git#branch=main'

build:
	go build -o bin/osctl ./client/cmd/osctl
	go build -o bin/node ./node/cmd/node
	go build -o bin/gateway ./gateway/cmd/gateway

vet:
	gofmt -l $$(git ls-files --cached --others --exclude-standard '*.go') | (! grep .)
	go vet ./...

# The web UI, built into gateway/internal/webui/build/dist for the gateway to
# embed (the gateway image does this itself). Run before make build to get a
# local bin/gateway that serves the UI.
web:
	cd web && npm ci && npm run build

# The UI's fast checks, as CI runs them.
web-check:
	cd web && npm ci && npm run lint && npm run typecheck && npm test
