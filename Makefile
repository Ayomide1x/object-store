BUF := go run github.com/bufbuild/buf/cmd/buf@v1.75.0

.PHONY: proto proto-lint proto-breaking build vet

# Regenerate Go stubs into gen/go (committed). Java stubs are generated by Gradle.
proto:
	$(BUF) generate

proto-lint:
	$(BUF) lint

# Fails if the wire format changed incompatibly versus main (invariant 9).
proto-breaking:
	$(BUF) breaking --against '.git#branch=main'

build:
	go build -o bin/osctl ./client/cmd/osctl
	go build -o bin/node ./node/cmd/node
	go build -o bin/gateway ./gateway/cmd/gateway

vet:
	gofmt -l . | (! grep .)
	go vet ./...
