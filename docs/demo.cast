[32.606305, "o", "\r\u001b[K   grace: 17s left"]
[33.651923, "o", "\r\u001b[K   grace: 16s left"]
[34.68453, "o", "\r\u001b[K   grace: 15s left"]
[35.724726, "o", "\r\u001b[K   grace: 14s left"]
