# The VM's .env (DEPLOY.md): copy to .env there, which is gitignored, and set
# the password. Compose reads .env automatically.
#
# Every docker compose command in this directory includes the production
# override, and the project has a fixed name (its volumes are
# objectstore_pgdata, objectstore_node1-data, ...).
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROJECT_NAME=objectstore
# Postgres and the coordinator. Takes effect only when the pgdata volume is
# first created: changing it later needs ALTER USER inside Postgres too.
# Generate with: openssl rand -base64 32 | tr -d '/+='
OBJECTSTORE_DB_PASSWORD=
